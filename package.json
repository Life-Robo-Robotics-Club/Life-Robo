{
  "name": "life-robo",
  "version": "1.0.0",
  "description": "Life Robo — Robotics Club, FoET, University of Lucknow. Cloudflare Worker + D1 + R2 site with admin panel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply life-robo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply life-robo-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "assets:prepare": "node scripts/prepare-assets.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.17",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true
  },
  "private": true
}
